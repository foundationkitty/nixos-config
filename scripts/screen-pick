#!/run/current-system/sw/bin/bash
export PATH="/run/wrappers/bin:/etc/profiles/per-user/$USER/bin:/run/current-system/sw/bin:$PATH"
set -uo pipefail
here="${BASH_SOURCE[0]%/*}"
log="${XDG_RUNTIME_DIR:-/tmp}/screen-pick.log"
mapfile -t labels
{ echo "== $(date '+%F %T')"; printf 'label: %q\n' "${labels[@]}"; } >"$log"
[ "${#labels[@]}" -gt 0 ] || exit 1

declare -A mode=(); focused=""
if outs=$(swaymsg -t get_outputs -p 2>/dev/null); then
  while read -r name m f; do
    mode[$name]=$m; [ "$f" = 1 ] && focused=$name
  done < <(awk '/^Output / { if (n) print n, m, f; n=$2; m="?"; f=($0 ~ /\(focused\)/) }
                /Current mode:/ { m=$3 } END { if (n) print n, m, f }' <<<"$outs")
fi

menu=""
for i in "${!labels[@]}"; do
  label=${labels[$i]}; n=$((i + 1))
  case $label in
    "Monitor: "*) rest=${label#Monitor: }; out=${rest%% *}
                  mark="   "; [ "$out" = "$focused" ] && mark="● "
                  menu+="${mark}${n}. Screen  ${rest}${mode[$out]:+  [${mode[$out]}]}"$'\n' ;;
    "Window: "*)  menu+="   ${n}. Window  ${label#Window: }"$'\n' ;;
    *)            menu+="   ${n}. ${label}"$'\n' ;;
  esac
done

tree=$(swaymsg -t get_tree -r 2>/dev/null) || tree=""
prev=""; spot=""
if [ -n "$tree" ]; then
  prev=$(jq -r 'first(.. | objects | select(.focused? == true) | .id) // empty' <<<"$tree")
  spot=$(jq -r '
    def hidden: (.name | startswith("HEADLESS-"))
      or (.current_workspace as $ws | [.nodes[] | select(.name == $ws) | .. | objects | select(.fullscreen_mode? == 1)] | length > 0);
    [.nodes[] | select(.type == "output" and .name != "__i3")] as $outs
    | ([$outs[] | select([.. | objects | select(.focused? == true)] | length > 0)] | first) as $cur
    | if $cur == null or ($cur | hidden | not) then empty
      else [$outs[] | select(hidden | not) | .name] | first // empty end' <<<"$tree")
fi
[ -n "$spot" ] && swaymsg -q "focus output $spot"

choice=$(printf '%s' "$menu" | "$here/pick-menu" "Share"); rc=$?
[ -n "$spot" ] && [ -n "$prev" ] && swaymsg -q "[con_id=$prev] focus"
printf 'menu exit %s, choice: %q\n' "$rc" "$choice" >>"$log"
[ "$rc" -eq 0 ] || exit 1
n=$(sed -nE 's/^[^0-9]*([0-9]+)\..*/\1/p' <<<"$choice")
if ! { [ -n "$n" ] && [ "$n" -ge 1 ] && [ "$n" -le "${#labels[@]}" ]; }; then
  echo "couldn't read a number from the choice (n=$n)" >>"$log"
  exit 1
fi
printf 'reply: %q\n' "${labels[$((n - 1))]}" >>"$log"
printf '%s\n' "${labels[$((n - 1))]}"
